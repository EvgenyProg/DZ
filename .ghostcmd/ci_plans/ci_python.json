{
  "plan": {
    "name": "CI (Generated by GhostCMD)",
    "on": {
      "push": {
        "branches": [
          "main"
        ]
      },
      "pull_request": {},
      "workflow_dispatch": {}
    },
    "env": {
      "PYTHONUNBUFFERED": "1"
    },
    "jobs": [
      {
        "id": "docker_build",
        "runs_on": "ubuntu-latest",
        "needs": [],
        "steps": [
          {
            "type": "checkout"
          },
          {
            "type": "docker_setup_buildx"
          },
          {
            "type": "docker_login",
            "registry": "ghcr.io",
            "user_expr": "${{ github.actor }}",
            "password_secret": "GHCR_TOKEN"
          },
          {
            "type": "docker_build_push",
            "context": ".",
            "tags": [
              "ghcr.io/${{ github.repository }}:sha-${{ github.sha }}"
            ]
          }
        ]
      }
    ],
    "intent": "python + docker + lint + coverage"
  },
  "sha256": "3e557fd052390635c1d7f1e252497f893073ed960265ee607f1f60ddd353ae74"
}